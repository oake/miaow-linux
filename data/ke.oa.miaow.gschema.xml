      <default>''</default>
      <summary>Last selected room identifier</summary>
    </key>
    <key name="normal-width" type="i"><default>1100</default></key>
    <key name="normal-height" type="i"><default>700</default></key>
    <key name="compact-width" type="i"><default>360</default></key>
    <key name="compact-height" type="i"><default>225</default></key>
