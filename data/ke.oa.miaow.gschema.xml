    <key name="local-pip-corner" type="s"><default>'bottom-right'</default></key>
    <key name="local-pip-width" type="i"><default>240</default></key>
    <key name="local-pip-height" type="i"><default>135</default></key>
    <key name="remote-pip-corner" type="s"><default>'bottom-left'</default></key>
    <key name="remote-pip-width" type="i"><default>240</default></key>
